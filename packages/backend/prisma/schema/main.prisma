model recovery_codes {
  /// 코드 발급 행의 UUID 식별자입니다.
  id         String    @id(map: "pk_recovery_codes") @default(uuid()) @db.Uuid
  /// 복구 대상 사용자 식별자입니다.
  user_id    String    @db.Uuid
  /// 복구 코드 검증용 해시입니다. 원문은 저장하지 않습니다.
  code_hash  String    @unique(map: "ux_recovery_codes_hash") @db.VarChar(128)
  /// 코드를 사용한 시각입니다. 사용한 코드는 다시 사용하지 않습니다.
  used_at    DateTime? @db.Timestamptz(3)
  /// 재발급 또는 탈퇴로 무효화한 시각입니다.
  revoked_at DateTime? @db.Timestamptz(3)
  /// 발급 행을 생성한 시각입니다.
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체입니다.
  created_by String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체입니다.
  updated_by String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제된 코드는 유효하지 않습니다.
  deleted_at DateTime? @db.Timestamptz(3)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id, used_at, revoked_at], map: "ix_recovery_codes_user_state")
  @@schema("accounts")
}

/// 사용자 로그인 계정과 분리한 시스템 감사 주체입니다. 작업 종류마다 고정 UUID를 등록합니다.
/// 감사 컬럼의 값은 서버가 선택합니다. 클라이언트가 주체를 지정하지 않습니다.
/// @namespace 계정
model system_principals {
  /// 승인한 작업 종류의 고정 UUID입니다. 자동 생성하지 않습니다.
  id         String    @id(map: "pk_system_principals") @db.Uuid
  /// 시스템 작업 종류의 ASCII 코드입니다.
  code       String    @unique(map: "ux_system_principals_code") @db.VarChar(64)
  /// 등록한 시각입니다.
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 등록 주체입니다.
  created_by String    @db.Uuid
  /// 등록 정보를 최근 변경한 시각입니다.
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체입니다.
  updated_by String    @db.Uuid
  /// 신규 작업 사용을 금지한 시각입니다. 과거 감사 식별자는 보존합니다.
  deleted_at DateTime? @db.Timestamptz(3)

  @@schema("accounts")
}

/// 트랜잭션을 완료한 명령의 재시도 결과입니다. 업무 변경과 같은 트랜잭션에 저장합니다.
/// 작업 식별자가 같고 입력 해시가 다르면 충돌로 거부합니다. 실패한 트랜잭션은 남기지 않습니다.
/// @namespace 계정
model command_receipts {
  /// 클라이언트가 재시도에도 유지하는 명령 UUID입니다. 자동 생성하지 않습니다.
  id            String    @id(map: "pk_command_receipts") @db.Uuid
  /// 인증으로 확인한 실행 사용자입니다. 재시도는 같은 사용자만 허용합니다.
  actor_user_id String    @db.Uuid
  /// 명령 종류의 서버 코드입니다.
  command_type  String    @db.VarChar(64)
  /// 정규화한 입력 계약의 소문자 SHA-256 값입니다.
  request_hash  String    @db.Char(64)
  /// 재시도에서 반환할 비밀값이 없는 완료 결과입니다.
  result        Json      @db.JsonB
  /// 명령을 완료한 시각입니다.
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체입니다.
  created_by    String    @db.Uuid
  /// 완료 시각과 같은 값입니다. 완료 결과는 덮어쓰지 않습니다.
  updated_at    DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체입니다.
  updated_by    String    @db.Uuid
  /// 보존 표시입니다. 같은 작업 식별자를 재사용하지 않습니다.
  deleted_at    DateTime? @db.Timestamptz(3)

  actor users @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actor_user_id, created_at], map: "ix_command_receipts_actor_time")
  @@schema("accounts")
}

/// 기기 간 이어할 수 있는 서버 타이머입니다. 실행·일시정지 타이머는 작업 공간당 하나입니다.
/// 이관은 타이머와 소유자 식별자를 바꾸지 않습니다. 종료와 기록 생성은 원자적으로 처리합니다.
/// @namespace 프로젝트
model project_timers {
  /// 서버 타이머의 안정적인 UUID 식별자입니다.
  id                  String         @id(map: "pk_project_timers") @default(uuid()) @db.Uuid
  /// 현재 개인 작업 공간의 식별자입니다. 프로젝트는 작업 공간을 통해 조회합니다.
  workspace_id        String         @db.Uuid
  /// 타이머를 소유한 사용자입니다. 작업 공간 소유자와 같아야 합니다.
  owner_user_id       String         @db.Uuid
  /// 실행·일시정지·종료 상태입니다.
  status              e_timer_status @default(running)
  /// 현재 실행 구간의 시작 시각입니다. 일시정지와 종료 상태에서는 NULL입니다.
  started_at          DateTime?      @db.Timestamptz(3)
  /// 완료한 실행 구간의 누적 초입니다. 현재 실행 구간은 조회·상태 변경 시 더합니다.
  accumulated_seconds Int            @default(0)
  /// 오래된 기기의 상태 변경을 거부할 변경 번호입니다.
  version             Int            @default(0)
  /// 기록 생성을 완료하고 타이머를 종료한 시각입니다.
  stopped_at          DateTime?      @db.Timestamptz(3)
  /// 종료와 같은 트랜잭션에서 생성한 기록입니다. 종료하지 않았으면 NULL입니다.
  record_id           String?        @unique(map: "ux_project_timers_record") @db.Uuid
  /// 타이머 행을 생성한 시각입니다.
  created_at          DateTime       @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체입니다.
  created_by          String         @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체입니다.
  updated_by          String         @db.Uuid
  /// 논리삭제 시각입니다. 콘텐츠 복구로 실행 타이머를 다시 시작하지 않습니다.
  deleted_at          DateTime?      @db.Timestamptz(3)

  workspace project_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner     users              @relation(fields: [owner_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  record    project_records?   @relation(fields: [record_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspace_id, status], map: "ix_project_timers_workspace_state")
  @@index([owner_user_id], map: "ix_project_timers_owner")
  @@schema("projects")
}

/// 권한을 확인한 운영자의 신고 조치 이력입니다. 생성한 업무 필드와 결과를 수정하지 않습니다.
/// 실행 주체는 created_by로 남깁니다. 일반 사용자에게 이력 수정 권한을 부여하지 않습니다.
/// @namespace 커뮤니티
model report_actions {
  /// 조치 이력의 UUID 식별자입니다.
  id          String    @id(map: "pk_report_actions") @default(uuid()) @db.Uuid
  /// 조치 대상 신고의 식별자입니다.
  report_id   String    @db.Uuid
  /// 실행한 상태 변경·숨김·차단 조치의 서버 코드입니다.
  action_code String    @db.VarChar(64)
  /// 조치 이유입니다. 일반 사용자에게 비공개인 운영 근거를 포함할 수 있습니다.
  reason      String    @db.Text
  /// 조치 실행 결과입니다. 인증 비밀값을 포함하지 않습니다.
  result      Json      @db.JsonB
  /// 조치를 기록한 시각입니다.
  created_at  DateTime  @default(now()) @db.Timestamptz(3)
  /// 인증으로 확인한 조치 실행 주체입니다.
  created_by  String    @db.Uuid
  /// 생성 시각과 같은 값입니다. 업무 필드와 결과를 덮어쓰지 않습니다.
  updated_at  DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체입니다.
  updated_by  String    @db.Uuid
  /// 보존 표시입니다. 표시 변경으로 조치 이력을 잃지 않습니다.
  deleted_at  DateTime? @db.Timestamptz(3)

  report reports @relation(fields: [report_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([report_id, created_at, id], map: "ix_report_actions_report_time")
  @@schema("community")
}
