// 뜨개로그 서비스의 초기 테이블 설계입니다.
// relation은 논리 관계를 표시합니다. 물리 FK는 생성하지 않습니다.
generator client {
  provider     = "prisma-client"
  output       = "../../src/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
  schemas      = ["accounts", "social", "projects", "community"]
}

generator markdown {
  provider = "prisma-markdown"
  title    = "뜨개로그 ERD - 논리 관계, 물리 FK 없음"
  output   = "../../docs/ERD.md"
}

/// 프로필 기록의 공개 범위입니다. 공동 프로젝트의 권한과 구분합니다.
enum e_profile_visibility {
  public
  friends
  private

  @@schema("accounts")
}

/// 개인 작업 공간의 작업 상태입니다. 참여 권한과 구분합니다.
enum e_workspace_status {
  active
  paused
  done

  @@schema("projects")
}

/// 친구 요청의 처리 상태입니다.
enum e_friend_request_status {
  pending
  accepted
  rejected
  cancelled

  @@schema("social")
}

/// 프로젝트 초대의 처리 상태입니다.
enum e_invitation_status {
  pending
  accepted
  rejected
  cancelled

  @@schema("projects")
}

/// 기록에 저장할 시간의 입력 경로입니다. 진행 중 타이머는 별도 행으로 저장합니다.
enum e_record_source {
  timer
  manual

  @@schema("projects")
}

/// 서버가 보존하는 타이머 상태입니다. 종료는 기록 저장과 함께 처리합니다.
enum e_timer_status {
  running
  paused
  stopped

  @@schema("projects")
}

/// 화면 이모지와 구분하는 기록 반응 코드입니다.
enum e_reaction_code {
  like
  heart
  clap
  celebrate
  wow

  @@schema("projects")
}

/// 이전 신고의 해석을 보존하는 신고 사유 코드입니다.
enum e_report_reason {
  spam
  abuse
  inappropriate
  privacy
  other

  @@schema("community")
}

/// 운영자가 관리하는 신고 처리 상태입니다.
enum e_report_status {
  received
  reviewing
  closed

  @@schema("community")
}

/// 다른 계정에 재발급하지 않는 계정 식별자 종류입니다.
enum e_identifier_kind {
  login_id
  handle

  @@schema("accounts")
}

/// 서비스 계정입니다. 로그인 ID와 공개 계정 ID를 분리합니다.
/// 비밀번호는 해시만 저장합니다. 탈퇴 시 공개 프로필과 인증 비밀값을 제거합니다.
/// @namespace 계정
/// @erd 친구와차단
/// @erd 프로젝트
/// @erd 기록
/// @erd 커뮤니티
model users {
  /// 사용자 식별자입니다. 가입 시 비즈니스 계층에서 감사 주체도 지정합니다.
  id                      String               @id(map: "pk_users") @default(uuid()) @db.Uuid
  /// 로그인에만 사용하는 값입니다. 다른 사용자에게 공개하지 않습니다.
  login_id                String               @unique(map: "ux_users_login_id") @db.VarChar(32)
  /// 현재 공개 계정 ID입니다. 탈퇴 시 제거하며 과거 값은 식별자 예약에 보존합니다.
  handle                  String?              @unique(map: "ux_users_handle") @db.VarChar(32)
  /// 사용자에게 표시하는 이름입니다. 탈퇴 후에는 저장값 대신 탈퇴한 사용자를 표시합니다.
  nickname                String?              @db.VarChar(100)
  /// 검증용 비밀번호 해시입니다. 원본 비밀번호는 저장하지 않습니다.
  password_hash           String?              @db.Text
  /// 접근 토큰의 유효성 번호입니다. 비밀번호 재설정과 탈퇴 시 증가시킵니다.
  auth_version            Int                  @default(0)
  /// 사용자가 작성한 소개입니다.
  biography               String?              @db.Text
  /// 프로필 사진의 저장 객체 식별자입니다. 표시 주소는 조회 시 생성합니다.
  profile_photo_object_id String?              @db.Uuid
  /// 프로필 기록과 총 작업 시간의 공개 범위입니다.
  visibility              e_profile_visibility @default(public)
  /// 행을 생성한 시각입니다.
  created_at              DateTime             @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by              String               @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at              DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by              String               @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at              DateTime?            @db.Timestamptz(3)

  sessions                 auth_sessions[]
  identifiers              user_identifiers[]
  recovery_codes           recovery_codes[]
  commands                 command_receipts[]
  timers                   project_timers[]
  consents                 policy_consents[]
  friend_requests_sent     friend_requests[]     @relation("friend_request_sender")
  friend_requests_received friend_requests[]     @relation("friend_request_recipient")
  friendships_low          friendships[]         @relation("friendship_low")
  friendships_high         friendships[]         @relation("friendship_high")
  blocks_sent              user_blocks[]         @relation("block_actor")
  blocks_received          user_blocks[]         @relation("block_target")
  projects_owned           projects[]
  memberships              project_memberships[]
  workspaces               project_workspaces[]
  profile_photo            stored_objects?       @relation("profile_photo", fields: [profile_photo_object_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owned_objects            stored_objects[]      @relation("stored_object_owner")
  invitations_sent         project_invitations[] @relation("invitation_sender")
  invitations_received     project_invitations[] @relation("invitation_recipient")
  records                  project_records[]
  record_comments          record_comments[]
  record_reactions         record_reactions[]
  posts                    posts[]
  post_comments            post_comments[]
  post_likes               post_likes[]
  reports_sent             reports[]             @relation("report_actor")
  reports_received         reports[]             @relation("report_target")

  @@index([nickname, id], map: "ix_users_nickname_id")
  @@index([profile_photo_object_id], map: "ix_users_profile_photo")
  @@schema("accounts")
}

/// 갱신과 로그아웃에 사용하는 세션입니다. 원본 갱신 토큰은 저장하지 않습니다.
/// 만료·폐기 검사와 갱신 충돌 처리는 비즈니스 계층의 책임입니다.
/// 과거 DB 복원 후 기존 세션을 무효화합니다. 콘텐츠 복구로 세션을 재활성화하지 않습니다.
/// @namespace 계정
model auth_sessions {
  /// 행의 UUID 식별자입니다.
  id                 String    @id(map: "pk_auth_sessions") @default(uuid()) @db.Uuid
  /// 관련 사용자의 논리 참조 식별자입니다.
  user_id            String    @db.Uuid
  /// 갱신 토큰의 해시입니다. 원본 토큰은 저장하지 않습니다.
  refresh_token_hash String    @unique(map: "ux_auth_sessions_refresh_token_hash") @db.VarChar(128)
  /// 불투명 접근 토큰의 해시입니다. 매 요청에서 현재 세션 상태를 확인합니다.
  access_token_hash  String    @unique(map: "ux_auth_sessions_access_token_hash") @db.VarChar(128)
  /// 접근 토큰의 만료 시각입니다. 갱신 세션의 만료와 구분합니다.
  access_expires_at  DateTime  @db.Timestamptz(3)
  /// 세션의 만료 시각입니다.
  expires_at         DateTime  @db.Timestamptz(3)
  /// 세션을 폐기한 시각입니다.
  revoked_at         DateTime? @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by         String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by         String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at         DateTime? @db.Timestamptz(3)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([user_id, expires_at], map: "ix_auth_sessions_user_expiry")
  @@schema("accounts")
}

/// 한국어 정책 문서입니다. 효력 시작 시각이 지난 최신 버전을 선택합니다.
/// 동의가 참조하는 버전의 본문은 수정하지 않습니다.
/// 정책 변경은 새 버전을 생성합니다. 공통 감사 컬럼은 본문 변경 허용을 뜻하지 않습니다.
/// @namespace 계정
model policy_documents {
  /// 행의 UUID 식별자입니다.
  id                 String    @id(map: "pk_policy_documents") @default(uuid()) @db.Uuid
  /// 정책 문서 종류의 ASCII 코드입니다.
  code               String    @db.VarChar(64)
  /// 동의 대상 문서의 버전 코드입니다.
  version            String    @db.VarChar(64)
  /// 문서 제목입니다.
  title              String    @db.VarChar(255)
  /// 콘텐츠 본문입니다.
  body               String    @db.Text
  /// 초기 정책 문서의 언어 코드입니다.
  language           String    @default("ko") @db.VarChar(8)
  /// 이 버전의 효력이 시작하는 시각입니다.
  effective_at       DateTime  @db.Timestamptz(3)
  /// 새 버전의 업무 변경 전에 사용자 재동의를 요구하는지 표시합니다.
  requires_reconsent Boolean   @default(true)
  /// 행을 생성한 시각입니다.
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by         String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by         String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at         DateTime? @db.Timestamptz(3)

  consents policy_consents[]

  @@unique([code, version], map: "ux_policy_documents_code_version")
  @@unique([code, effective_at], map: "ux_policy_documents_code_effective")
  @@schema("accounts")
}

/// 사용자가 동의한 정책 버전과 시각입니다. 버전은 정책 문서를 통해 식별합니다.
/// @namespace 계정
model policy_consents {
  /// 행의 UUID 식별자입니다.
  id                 String    @id(map: "pk_policy_consents") @default(uuid()) @db.Uuid
  /// 관련 사용자의 논리 참조 식별자입니다.
  user_id            String    @db.Uuid
  /// 동의한 정책 버전의 논리 참조 식별자입니다.
  policy_document_id String    @db.Uuid
  /// 사용자가 정책에 동의한 시각입니다.
  agreed_at          DateTime  @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by         String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by         String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at         DateTime? @db.Timestamptz(3)

  user     users            @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  document policy_documents @relation(fields: [policy_document_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([user_id, policy_document_id], map: "ux_policy_consents_user_document")
  @@index([user_id, agreed_at], map: "ix_policy_consents_user_time")
  @@index([policy_document_id], map: "ix_policy_consents_document")
  @@schema("accounts")
}

/// 방향이 있는 친구 요청입니다. 처리한 요청은 새 요청과 구분해 보존할 수 있습니다.
/// 양방향 대기 요청의 중복은 design-constraints.sql의 부분 고유 인덱스로 제한합니다.
/// 반대 방향의 대기 요청이 있으면 요청 처리와 친구 생성을 함께 수행합니다.
/// @namespace 친구와차단
model friend_requests {
  /// 행의 UUID 식별자입니다.
  id           String                  @id(map: "pk_friend_requests") @default(uuid()) @db.Uuid
  /// 요청 또는 초대를 보낸 사용자의 식별자입니다.
  sender_id    String                  @db.Uuid
  /// 요청 또는 초대를 받은 사용자의 식별자입니다.
  recipient_id String                  @db.Uuid
  /// 해당 행의 업무 처리 상태입니다.
  status       e_friend_request_status @default(pending)
  /// 요청 또는 초대를 처리한 시각입니다.
  responded_at DateTime?               @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at   DateTime                @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by   String                  @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at   DateTime                @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by   String                  @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at   DateTime?               @db.Timestamptz(3)

  sender    users @relation("friend_request_sender", fields: [sender_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient users @relation("friend_request_recipient", fields: [recipient_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sender_id, recipient_id, status], map: "ix_friend_requests_pair_status")
  @@index([recipient_id, status, created_at], map: "ix_friend_requests_inbox")
  @@schema("social")
}

/// 상호 친구 관계입니다. 작은 사용자 ID와 큰 사용자 ID의 순서로 저장합니다.
/// 자기 자신과의 관계와 역순 입력은 비즈니스 계층에서 거부합니다.
/// 해제 후 재연결할 때 같은 관계 행을 재사용하는 것은 설계 제안입니다.
/// @namespace 친구와차단
model friendships {
  /// 행의 UUID 식별자입니다.
  id           String    @id(map: "pk_friendships") @default(uuid()) @db.Uuid
  /// 정렬한 사용자 쌍에서 작은 식별자입니다.
  user_low_id  String    @db.Uuid
  /// 정렬한 사용자 쌍에서 큰 식별자입니다.
  user_high_id String    @db.Uuid
  /// 행을 생성한 시각입니다.
  created_at   DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by   String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by   String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at   DateTime? @db.Timestamptz(3)

  user_low  users @relation("friendship_low", fields: [user_low_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user_high users @relation("friendship_high", fields: [user_high_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([user_low_id, user_high_id], map: "ux_friendships_pair")
  @@index([user_high_id, deleted_at], map: "ix_friendships_high_active")
  @@schema("social")
}

/// 차단한 방향을 저장합니다. 노출 제한은 양쪽 방향을 검사합니다.
/// 차단 해제 시 반대 방향의 차단까지 해제하지 않습니다.
/// 기존 공동 프로젝트 멤버십은 삭제하지 않습니다.
/// 콘텐츠 복구는 차단 상태를 변경하지 않습니다.
/// @namespace 친구와차단
model user_blocks {
  /// 행의 UUID 식별자입니다.
  id         String    @id(map: "pk_user_blocks") @default(uuid()) @db.Uuid
  /// 차단을 실행한 사용자의 식별자입니다.
  blocker_id String    @db.Uuid
  /// 차단 대상 사용자의 식별자입니다.
  blocked_id String    @db.Uuid
  /// 행을 생성한 시각입니다.
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at DateTime? @db.Timestamptz(3)

  blocker users @relation("block_actor", fields: [blocker_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  blocked users @relation("block_target", fields: [blocked_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([blocker_id, blocked_id], map: "ux_user_blocks_pair")
  @@index([blocked_id, deleted_at], map: "ix_user_blocks_target_active")
  @@schema("social")
}

/// 비공개 공유 작업 공간입니다. 방장 정보의 기준은 owner_user_id 하나입니다.
/// 비즈니스 계층은 방장이 유효한 멤버인지 검사합니다.
/// 개인 이관 프로젝트도 같은 모델을 사용합니다.
/// @namespace 프로젝트
model projects {
  /// 행의 UUID 식별자입니다.
  id                    String    @id(map: "pk_projects") @default(uuid()) @db.Uuid
  /// 현재 방장의 사용자 식별자입니다.
  owner_user_id         String    @db.Uuid
  /// 프로젝트 또는 카운터의 표시 이름입니다.
  name                  String    @db.VarChar(255)
  /// 프로젝트 대표 사진의 저장 객체 식별자입니다. 이관 프로젝트도 같은 객체를 참조할 수 있습니다.
  cover_photo_object_id String?   @db.Uuid
  /// 마지막 참여자가 나가 프로젝트를 종료한 시각입니다. 신규 참여와 쓰기를 금지합니다.
  terminated_at         DateTime? @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by            String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by            String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at            DateTime? @db.Timestamptz(3)
  /// 이 행을 직접 삭제한 작업의 UUID입니다. 복구 시 삭제 시각과 함께 제거합니다.
  deletion_operation_id String?   @db.Uuid

  owner          users                 @relation(fields: [owner_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships    project_memberships[]
  workspaces     project_workspaces[]
  invitations    project_invitations[]
  cover_photo    stored_objects?       @relation("cover_photo", fields: [cover_photo_object_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transfers_from workspace_transfers[] @relation("transfer_source_project")
  transfers_to   workspace_transfers[] @relation("transfer_destination_project")

  @@index([owner_user_id, deleted_at], map: "ix_projects_owner_active")
  @@index([cover_photo_object_id], map: "ix_projects_cover_photo")
  @@index([deletion_operation_id], map: "ix_projects_deletion_operation")
  @@schema("projects")
}

/// 사용자의 프로젝트 참여 기간입니다. 개인 작업 데이터는 소유하지 않습니다.
/// 참여 종료는 left_at을 기록합니다. 재가입은 새 행을 생성합니다.
/// 유효한 참여는 left_at과 deleted_at이 모두 NULL인 행입니다.
/// 같은 프로젝트와 사용자의 유효한 참여는 부분 고유 인덱스로 하나만 허용합니다.
/// @namespace 프로젝트
model project_memberships {
  /// 행의 UUID 식별자입니다.
  id         String    @id(map: "pk_project_memberships") @default(uuid()) @db.Uuid
  /// 참여하거나 초대한 프로젝트의 논리 참조 식별자입니다.
  project_id String    @db.Uuid
  /// 관련 사용자의 논리 참조 식별자입니다.
  user_id    String    @db.Uuid
  /// 참여를 종료한 시각입니다. 작업 완료나 콘텐츠 삭제와 구분합니다.
  left_at    DateTime? @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at DateTime? @db.Timestamptz(3)

  project        projects              @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           users                 @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transfers_from workspace_transfers[] @relation("transfer_source_membership")
  transfers_to   workspace_transfers[] @relation("transfer_destination_membership")

  @@index([project_id, user_id], map: "ix_project_memberships_project_user")
  @@index([user_id, left_at, created_at], map: "ix_project_memberships_user_period")
  @@schema("projects")
}

/// 사용자가 소유한 개인 작업 공간입니다. 참여 권한은 멤버십으로 판정합니다.
/// 작업 상태와 실·바늘 메모는 이 행에 귀속됩니다.
/// 이관은 project_id를 변경합니다. 하위 데이터와 원 작성자의 식별자는 유지합니다.
/// 모든 하위 데이터 변경은 이 행을 잠그고 version을 증가시킵니다.
/// @namespace 프로젝트
/// @erd 기록
model project_workspaces {
  /// 행의 UUID 식별자입니다. 이관 후에도 유지합니다.
  id                    String             @id(map: "pk_project_workspaces") @default(uuid()) @db.Uuid
  /// 현재 작업 공간이 속한 프로젝트의 식별자입니다.
  project_id            String             @db.Uuid
  /// 개인 작업 공간을 소유한 사용자의 식별자입니다.
  owner_user_id         String             @db.Uuid
  /// 개인 작업의 상태입니다. 참여 종료 상태가 아닙니다.
  status                e_workspace_status @default(active)
  /// 사용자가 사용하는 실의 텍스트 메모입니다. 초기 버전은 구조화하지 않습니다.
  yarn_notes            String?            @db.Text
  /// 사용자가 사용하는 바늘의 텍스트 메모입니다. 초기 버전은 구조화하지 않습니다.
  needle_notes          String?            @db.Text
  /// done 상태로 변경한 시각입니다. 다른 상태에서는 NULL입니다.
  ended_at              DateTime?          @db.Timestamptz(3)
  /// 이관과 하위 데이터 변경을 포함한 작업 공간의 변경 번호입니다.
  version               Int                @default(0)
  /// 행을 생성한 시각입니다.
  created_at            DateTime           @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by            String             @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at            DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by            String             @db.Uuid
  /// 이 작업 공간을 직접 삭제한 시각입니다. 프로젝트 삭제로 변경하지 않습니다.
  deleted_at            DateTime?          @db.Timestamptz(3)
  /// 이 행을 직접 삭제한 작업의 UUID입니다. 복구 시 삭제 시각과 함께 제거합니다.
  deletion_operation_id String?            @db.Uuid

  project   projects              @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner     users                 @relation(fields: [owner_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counters  project_counters[]
  records   project_records[]
  timers    project_timers[]
  transfers workspace_transfers[]

  @@unique([project_id, owner_user_id], map: "ux_project_workspaces_project_owner")
  @@index([owner_user_id, status, created_at], map: "ix_project_workspaces_owner_status")
  @@index([deletion_operation_id], map: "ix_project_workspaces_deletion_operation")
  @@schema("projects")
}

/// 완료된 이관의 변경 전후 관계를 보존합니다. 생성 후 업무 필드를 변경하지 않습니다.
/// id는 이관 작업 식별자입니다. 재시도는 같은 id와 같은 입력을 사용합니다.
/// 생성 시각과 생성 주체는 이관 완료 시각과 처리 주체입니다.
/// 역이관은 새 이관 행을 생성합니다. 기존 이력을 덮어쓰지 않습니다.
/// @namespace 프로젝트
model workspace_transfers {
  /// 이관 작업의 UUID입니다. 중복 처리와 요청 내용의 일치를 확인합니다.
  id                 String    @id(map: "pk_workspace_transfers") @db.Uuid
  /// 이동한 개인 작업 공간의 식별자입니다.
  workspace_id       String    @db.Uuid
  /// 이관 전 프로젝트의 식별자입니다.
  from_project_id    String    @db.Uuid
  /// 이관 후 프로젝트의 식별자입니다.
  to_project_id      String    @db.Uuid
  /// 이관에서 종료한 참여 기간의 식별자입니다.
  from_membership_id String    @db.Uuid
  /// 이관에서 생성한 참여 기간의 식별자입니다.
  to_membership_id   String    @db.Uuid
  /// 이관 완료 직후 작업 공간의 변경 번호입니다. 역이관은 현재 번호와 비교합니다.
  workspace_version  Int
  /// 이관을 완료한 시각입니다.
  created_at         DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 이관 처리 주체의 식별자입니다.
  created_by         String    @db.Uuid
  /// 생성 시각과 같은 값입니다. 이력의 업무 필드는 변경하지 않습니다.
  updated_at         DateTime  @default(now()) @db.Timestamptz(3)
  /// 생성 주체와 같은 값입니다. 이력의 업무 필드는 변경하지 않습니다.
  updated_by         String    @db.Uuid
  /// 보존 정책의 별도 승인 전까지 NULL을 유지합니다. 콘텐츠 복구 대상이 아닙니다.
  deleted_at         DateTime? @db.Timestamptz(3)

  workspace       project_workspaces  @relation(fields: [workspace_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  from_project    projects            @relation("transfer_source_project", fields: [from_project_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  to_project      projects            @relation("transfer_destination_project", fields: [to_project_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  from_membership project_memberships @relation("transfer_source_membership", fields: [from_membership_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  to_membership   project_memberships @relation("transfer_destination_membership", fields: [to_membership_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspace_id, workspace_version], map: "ux_workspace_transfers_workspace_version")
  @@index([from_project_id], map: "ix_workspace_transfers_from_project")
  @@index([to_project_id], map: "ix_workspace_transfers_to_project")
  @@index([from_membership_id], map: "ix_workspace_transfers_from_membership")
  @@index([to_membership_id], map: "ix_workspace_transfers_to_membership")
  @@schema("projects")
}

/// 친구에게 보낸 프로젝트 초대입니다.
/// 비즈니스 계층은 중복 대기 초대, 친구 관계와 차단을 검사합니다.
/// 수락 처리와 멤버십·작업 공간·기본 카운터 생성은 하나의 트랜잭션으로 처리합니다.
/// 중복 대기 초대는 design-constraints.sql의 부분 고유 인덱스로 제한합니다.
/// @namespace 프로젝트
model project_invitations {
  /// 행의 UUID 식별자입니다.
  id           String              @id(map: "pk_project_invitations") @default(uuid()) @db.Uuid
  /// 참여하거나 초대한 프로젝트의 논리 참조 식별자입니다.
  project_id   String              @db.Uuid
  /// 요청 또는 초대를 보낸 사용자의 식별자입니다.
  sender_id    String              @db.Uuid
  /// 요청 또는 초대를 받은 사용자의 식별자입니다.
  recipient_id String              @db.Uuid
  /// 해당 행의 업무 처리 상태입니다.
  status       e_invitation_status @default(pending)
  /// 요청 또는 초대를 처리한 시각입니다.
  responded_at DateTime?           @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at   DateTime            @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by   String              @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by   String              @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at   DateTime?           @db.Timestamptz(3)

  project   projects @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sender    users    @relation("invitation_sender", fields: [sender_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recipient users    @relation("invitation_recipient", fields: [recipient_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([project_id, recipient_id, status], map: "ix_project_invitations_target")
  @@index([recipient_id, status, created_at], map: "ix_project_invitations_inbox")
  @@index([sender_id, status], map: "ix_project_invitations_sender")
  @@schema("projects")
}

/// 멤버 개인의 카운터입니다. 가입 시 기본 카운터 두 개를 생성합니다.
/// 값은 음수가 될 수 없습니다. 목표 초과는 허용합니다.
/// 추가·삭제·표시 여부·순서를 지원합니다. 변경 명령의 재시도는 작업 식별자를 유지합니다.
/// @namespace 프로젝트
model project_counters {
  /// 행의 UUID 식별자입니다.
  id                    String    @id(map: "pk_project_counters") @default(uuid()) @db.Uuid
  /// 개인 작업 데이터를 소유한 작업 공간의 식별자입니다.
  workspace_id          String    @db.Uuid
  /// 프로젝트 또는 카운터의 표시 이름입니다.
  name                  String    @db.VarChar(100)
  /// 현재 카운터 값입니다. 비즈니스 계층은 음수를 거부합니다.
  value                 Int       @default(0)
  /// 선택한 목표 값입니다. 현재 값의 목표 초과는 허용합니다.
  target_value          Int?
  /// 화면에 표시할지 지정합니다. 숨겨도 현재 값은 유지합니다.
  is_visible            Boolean   @default(true)
  /// 같은 작업 공간 안의 표시 순서입니다. 서버가 기대 version을 확인해 변경합니다.
  sort_order            Int       @default(0)
  /// 설정·초기화·순서 변경의 낙관적 충돌 검사용 변경 번호입니다.
  version               Int       @default(0)
  /// 행을 생성한 시각입니다.
  created_at            DateTime  @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by            String    @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by            String    @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at            DateTime? @db.Timestamptz(3)
  /// 이 행을 직접 삭제한 작업의 UUID입니다. 복구 시 삭제 시각과 함께 제거합니다.
  deletion_operation_id String?   @db.Uuid

  workspace project_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspace_id, deleted_at], map: "ix_project_counters_workspace_active")
  @@index([deletion_operation_id], map: "ix_project_counters_deletion_operation")
  @@schema("projects")
}

/// 완료된 시간 기록 또는 직접 입력한 기록입니다. 진행 중 타이머 상태가 아닙니다.
/// 프로젝트는 작업 공간을 통해 조회합니다. 프로젝트 ID를 중복 저장하지 않습니다.
/// 이관 시 작성자, 댓글과 반응의 식별자를 유지합니다.
/// @namespace 기록
model project_records {
  /// 행의 UUID 식별자입니다.
  id                    String          @id(map: "pk_project_records") @default(uuid()) @db.Uuid
  /// 개인 작업 데이터를 소유한 작업 공간의 식별자입니다.
  workspace_id          String          @db.Uuid
  /// 콘텐츠를 작성한 사용자의 식별자입니다.
  author_id             String          @db.Uuid
  /// 작업 시간의 입력 경로입니다.
  source                e_record_source
  /// 콘텐츠 본문입니다.
  body                  String?         @db.Text
  /// 작업 시간의 저장 단위는 초로 제안합니다. 음수는 거부합니다.
  duration_seconds      Int
  /// 작업 기록의 기준 시각입니다.
  recorded_at           DateTime        @db.Timestamptz(3)
  /// 행을 생성한 시각입니다.
  created_at            DateTime        @default(now()) @db.Timestamptz(3)
  /// 서버가 확인한 생성 주체의 식별자입니다.
  created_by            String          @db.Uuid
  /// 행을 최근 변경한 시각입니다.
  updated_at            DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  /// 서버가 확인한 최근 변경 주체의 식별자입니다.
  updated_by            String          @db.Uuid
  /// 논리삭제 시각입니다. 삭제되지 않았으면 NULL입니다.
  deleted_at            DateTime?       @db.Timestamptz(3)
  /// 이 행을 직접 삭제한 작업의 UUID입니다. 복구 시 삭제 시각과 함께 제거합니다.
  deletion_operation_id String?         @db.Uuid

  workspace project_workspaces @relation(fields: [workspace_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author    users              @relation(fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  comments  record_comments[]
  reactions record_reactions[]
  timer     project_timers?

