  user users @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([kind, value], map: "ux_user_identifiers_kind_value")
  @@index([user_id, kind], map: "ix_user_identifiers_user_kind")
  @@schema("accounts")
}

/// 일회용 계정 복구 코드입니다. 원문은 발급 응답에서 한 번 제공하며 저장하지 않습니다.
/// 사용과 재발급은 사용자 잠금 아래에서 이전 코드를 무효화합니다.
