{
  "private": true,
  "name": "@knittinglog/back",
  "version": "0.1.0",
  "description": "Backend for PROJECT",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -C packages/backend dev",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "start": "pnpm -C packages/backend start",
    "test": "pnpm -C packages/backend test",
    "build:erd": "pnpm -C packages/backend build:erd",
    "check:evidence": "pnpm -C packages/backend check:evidence",
    "check:graph": "node scripts/ttsc-cache.cjs node scripts/check-ttsc-graph.cjs",
    "ttsc": "node scripts/ttsc-cache.cjs ttsc",
    "ttsx": "node scripts/ttsc-cache.cjs ttsx",
    "ttsc-graph": "node scripts/ttsc-cache.cjs ttsc-graph",
    "graph:backend": "pnpm -C packages/backend graph",
    "graph:api": "pnpm -C packages/api graph"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samchon/backend"
  },
  "author": "AUTHOR",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samchon/backend/issues"
  },
  "homepage": "https://github.com/samchon/backend",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@ttsc/lint": "catalog:typescript"
  }
}
